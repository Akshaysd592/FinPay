# Prefer scripts/run-local.ps1, which creates random local passwords automatically.
# If copying this template to .env manually, fill both passwords before starting Compose.
FINPAY_DB_PASSWORD=
FINPAY_IDP_PASSWORD=
# Optional local-only Ollama inference. No external AI subscription or API key is needed.
AI_ENABLED=false
AI_MODEL=qwen2.5:1.5b
